{
  "manifest_version": 3,
  "name": "SetOnce",
  "version": "1.0.0",
  "description": "Applies your saved cookie consent choices automatically, so banners never appear.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SetOnce settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
